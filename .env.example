# Copiá este archivo como .env.local (local) o cargá estas variables en Vercel.
# NUNCA subas .env.local a GitHub.

# URL pública del sitio (para SEO, sitemap y links al compartir)
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# Reseñas de Google (opcional) — ver docs/INTEGRACIONES.md
# Son variables de SERVIDOR: no llevan el prefijo NEXT_PUBLIC_ y no llegan al navegador.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
