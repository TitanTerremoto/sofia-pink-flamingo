# Copiá este archivo como .env.local (local) o cargá estas variables en Vercel.
# NUNCA subas .env.local a GitHub.
# Las variables NEXT_PUBLIC_* son visibles en el navegador: nunca pongas secretos ahí.

# URL pública del sitio (SEO, sitemap, links al compartir)
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# ── Fase 2: base de datos (docs/FASE2-PUESTA-EN-MARCHA.md) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: sólo servidor
SUPABASE_SERVICE_ROLE_KEY=

# Anti-spam (opcional, recomendado)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRETA
TURNSTILE_SECRET_KEY=

# ── Reseñas de Google (opcional, docs/INTEGRACIONES.md) ── SECRETAS
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
